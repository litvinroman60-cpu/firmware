#!/bin/sh

case "$1" in
    start)
        echo "Starting msposd..."
        [ -x /usr/bin/msposd ] || exit 0
        [ -e /dev/ttyS2 ] || exit 0

        # SSC377D / Infinity6C:
        # Betaflight MSP DisplayPort on UART2, 115200 baud.
        # Star-C uses 1280x720 in the default venc configuration.
        msposd -b 115200 -c 8 -r 20 -m /dev/ttyS2 -z 1280x720 > /dev/null 2>&1 &
        ;;

    stop)
        echo "Stopping msposd..."
        killall -q msposd
        ;;

    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
