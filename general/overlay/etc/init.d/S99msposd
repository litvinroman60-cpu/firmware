#!/bin/sh

case "$1" in
    start)
        echo "Starting msposd..."
        [ -x /usr/bin/msposd ] || { echo "msposd not installed"; exit 0; }
        [ -e /dev/ttyS2 ] || { echo "/dev/ttyS2 not found"; exit 0; }
        killall -q msposd 2>/dev/null || true
        msposd -b 115200 -c 8 -r 20 -m /dev/ttyS2 -z 1280x720 >/dev/null 2>&1 &
        ;;
    stop)
        killall -q msposd 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
exit 0
